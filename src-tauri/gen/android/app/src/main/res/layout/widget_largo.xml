<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 3×1 a 5×1: capa, título/artista e botões. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">
    <ImageView
        android:id="@+id/w_capa"
        android:layout_width="48dp" android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_capa"
        android:src="@drawable/widget_capa_vazia" />
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_titulo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/tema_texto"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/w_artista"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/tema_fraco"
            android:textSize="12sp" />
    </LinearLayout>
        <ImageButton
            android:id="@+id/w_anterior"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_anterior"
            android:src="@drawable/widget_anterior" />
        <ImageButton
            android:id="@+id/w_alternar"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_botao_tocar"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_alternar"
            android:src="@drawable/widget_tocar" />
        <ImageButton
            android:id="@+id/w_proxima"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_proxima"
            android:src="@drawable/widget_proxima" />
</LinearLayout>
