<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2: botões em cima, capas das playlists recentes embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="6dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_anterior"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_anterior"
            android:src="@drawable/widget_anterior" />
        <ImageButton
            android:id="@+id/w_alternar"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/widget_botao_tocar"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_alternar"
            android:src="@drawable/widget_tocar" />
        <ImageButton
            android:id="@+id/w_proxima"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_proxima"
            android:src="@drawable/widget_proxima" />
    </LinearLayout>
    <!-- Capas quadradas: a largura se divide e a altura acompanha (adjustViewBounds). -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_pl1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_capa_fundo"
            android:clipToOutline="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_playlist"
            android:src="@drawable/widget_capa_vazia" />
        <ImageView
            android:id="@+id/w_pl2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_capa_fundo"
            android:clipToOutline="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_playlist"
            android:src="@drawable/widget_capa_vazia" />
        <ImageView
            android:id="@+id/w_pl3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_capa_fundo"
            android:clipToOutline="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_playlist"
            android:src="@drawable/widget_capa_vazia" />
        <ImageView
            android:id="@+id/w_pl4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_capa_fundo"
            android:clipToOutline="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_playlist"
            android:src="@drawable/widget_capa_vazia" />
        <ImageView
            android:id="@+id/w_pl5"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:adjustViewBounds="true"
            android:background="@drawable/widget_capa_fundo"
            android:clipToOutline="true"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_playlist"
            android:src="@drawable/widget_capa_vazia" />
    </LinearLayout>
</LinearLayout>
