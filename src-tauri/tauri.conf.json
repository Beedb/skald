{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skald",
  "version": "0.4.1",
  "identifier": "com.skald.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skáld",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgstreamer1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "skald.desktop"
      },
      "rpm": {
        "depends": [
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ],
        "recommends": [
          "gstreamer1-plugin-libav",
          "libayatana-appindicator-gtk3"
        ],
        "desktopTemplate": "skald.desktop"
      }
    },
    "category": "Music"
  }
}
